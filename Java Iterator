import java.util.* ;

class JavaIterator01
{
public static void main(String[] args)
{
ArrayList<String> colours = new ArrayList<>();
colours.add("Yellow");
colours.add("Green");
colours.add("Purple");
colours.add("Red");
colours.add("Turquoise");
colours.add("Fuchsia");

Iterator itr =  colours.iterator();
System.out.println("Colours   ");

while (itr.hasNext())
{
System.out.println(itr.next() + "   ");
}

}
}
